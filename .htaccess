###############################################################################
# techad.pl — .htaccess
# SeoHost / DirectAdmin / LiteSpeed / Apache compatible
# Czysty HTML/CSS/JS
#
# Kanoniczna domena:
# https://techad.pl
#
# WWW -> BEZ WWW
# /index.html -> /
# /kontakt.html -> /kontakt
# /kontakt -> wewnętrznie ładuje /kontakt.html
###############################################################################

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# 0) Ochrona plików ukrytych
#    Ważne: NIE blokujemy .well-known, bo używa go Let's Encrypt / ACME.
# ---------------------------------------------------------------------------

<FilesMatch "(^|/)\.(?!well-known)">
  Require all denied
</FilesMatch>

# Blokada dostępu do plików technicznych, kopii i konfiguracji
<FilesMatch "(^composer\.|^package\.|^webpack\.|^gulpfile\.|^Gruntfile\.|\.env|\.log|\.sql|\.bak|\.backup|\.old|\.orig|\.save|\.swp|\.tmp|\.config|\.ini|\.sh|\.zip|\.tar|\.gz|\.rar|\.7z)$">
  Require all denied
</FilesMatch>


# ---------------------------------------------------------------------------
# 1) Rewrite
# ---------------------------------------------------------------------------

RewriteEngine On


# ---------------------------------------------------------------------------
# 2) Wymuś HTTPS i wersję bez WWW
#
# Przykłady:
# http://techad.pl        -> https://techad.pl
# http://www.techad.pl    -> https://techad.pl
# https://www.techad.pl   -> https://techad.pl
# ---------------------------------------------------------------------------

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.techad\.pl$ [NC]
RewriteRule ^ https://techad.pl%{REQUEST_URI} [L,R=301]


# ---------------------------------------------------------------------------
# 3) Usuń /index.html z adresu strony głównej
#
# /index.html -> /
# ---------------------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]


# ---------------------------------------------------------------------------
# 4) Usuń .html z adresu widocznego dla użytkownika
#
# /kontakt.html -> /kontakt
# /uslugi.html  -> /uslugi
# ---------------------------------------------------------------------------

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [L,R=301]


# ---------------------------------------------------------------------------
# 5) Wewnętrzne mapowanie adresów bez .html
#
# /kontakt -> /kontakt.html
# /uslugi  -> /uslugi.html
#
# Działa tylko wtedy, gdy:
# - żądany adres nie jest istniejącym folderem,
# - żądany adres nie jest istniejącym plikiem,
# - istnieje odpowiadający plik .html.
# ---------------------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]


# ---------------------------------------------------------------------------
# 6) Własna strona błędu 404
#
# Utwórz plik:
# /public_html/404.html
# ---------------------------------------------------------------------------

ErrorDocument 404 /404.html


# ---------------------------------------------------------------------------
# 7) MIME types
# ---------------------------------------------------------------------------

AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType font/woff .woff


# ---------------------------------------------------------------------------
# 8) CACHE — czasy wygasania treści
# ---------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — krótko, żeby zmiany na stronie szybko się pokazywały
  ExpiresByType text/html "access plus 10 minutes"

  # CSS / JS
  ExpiresByType text/css "access plus 2 days"
  ExpiresByType application/javascript "access plus 2 days"
  ExpiresByType text/javascript "access plus 2 days"

  # Obrazy
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/jpg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"

  # Fonty
  ExpiresByType font/woff2 "access plus 180 days"
  ExpiresByType font/woff "access plus 180 days"
  ExpiresByType application/font-woff2 "access plus 180 days"

  # PDF
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>


# ---------------------------------------------------------------------------
# 9) Cache-Control
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>

  # HTML — bez agresywnego cache
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CSS / JS — 2 dni
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=172800"
  </FilesMatch>

  # Obrazy — 7 dni
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Fonty — 180 dni
  <FilesMatch "\.(woff|woff2)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>

  # PDF — 30 dni
  <FilesMatch "\.(pdf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

</IfModule>


# ---------------------------------------------------------------------------
# 10) Kompresja GZIP
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>


# ---------------------------------------------------------------------------
# 11) Podstawowe nagłówki bezpieczeństwa
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # Uwaga:
  # X-XSS-Protection jest starym nagłówkiem, ale nie szkodzi starszym przeglądarkom.
  Header always set X-XSS-Protection "1; mode=block"

</IfModule>


# ---------------------------------------------------------------------------
# 12) HSTS
#
# Włączone bez "preload", żeby było bezpieczniej na start.
# Włączaj tylko wtedy, gdy SSL działa poprawnie dla:
# - techad.pl
# - www.techad.pl
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>


# ---------------------------------------------------------------------------
# 13) Content Security Policy — POPRAWIONE
#
# Pozwala na:
# - Bootstrap z cdn.jsdelivr.net
# - Chart.js z cdn.jsdelivr.net
# - Ionicons z unpkg.com
# - Smoothscroll z cdnjs.cloudflare.com
# - EmailJS przez api.emailjs.com
# - Google Fonts
# - Google Maps
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://api.emailjs.com; script-src-elem 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://api.emailjs.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.emailjs.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.google.com/maps/; object-src 'none'; base-uri 'self'; form-action 'self' https://api.emailjs.com; frame-ancestors 'self'; upgrade-insecure-requests;"
</IfModule>



# ---------------------------------------------------------------------------
# 14) Prosta blokada wybranych botów obciążających serwer
#
# Możesz to usunąć, jeśli chcesz, żeby narzędzia SEO typu Ahrefs/Semrush
# mogły swobodnie skanować stronę.
# ---------------------------------------------------------------------------

SetEnvIfNoCase User-Agent "AhrefsBot" bad_bot
SetEnvIfNoCase User-Agent "SemrushBot" bad_bot
SetEnvIfNoCase User-Agent "MJ12bot" bad_bot
SetEnvIfNoCase User-Agent "DotBot" bad_bot

<RequireAll>
  Require all granted
  Require not env bad_bot
</RequireAll>


###############################################################################
# KONIEC
###############################################################################