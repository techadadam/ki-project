###############################################################################
# inwestycje.kaminscypodlogi.pl — .htaccess (Czysty HTML/CSS/JS)
# Apache / Cyber_Folks / DirectAdmin
# Kanoniczna domena: https://inwestycje.kaminscypodlogi.pl  (WWW -> BEZ WWW)
# Strona główna z pliku index.html, adresy podstron bez rozszerzenia .html
# Przykład: /podlogi -> /podlogi.html
###############################################################################

Options -Indexes
DirectoryIndex index.html

# Blokada dostępu do plików ukrytych (z wyjątkiem .well-known używanego np. do SSL)
<FilesMatch "(^|/)\.(?!well-known)">
  Require all denied
</FilesMatch>

RewriteEngine On

# ---------------------------------------------------------------------------
# 1) Wymuś HTTPS i wersję bez WWW
#    Jeśli wejście jest po HTTP albo przez www.inwestycje.kaminscypodlogi.pl,
#    następuje przekierowanie 301 na:
#    https://inwestycje.kaminscypodlogi.pl
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.inwestycje\.kaminscypodlogi\.pl$ [NC]
RewriteRule ^ https://inwestycje.kaminscypodlogi.pl%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# 2) Usuń /index.html z adresu strony głównej
#    Przykład:
#    /index.html  ->  /
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# ---------------------------------------------------------------------------
# 3) Usuń .html z adresu widocznego dla użytkownika
#    Przykład:
#    /podlogi.html  ->  /podlogi
#    Reguła działa tylko dla bezpośredniego żądania z przeglądarki,
#    więc nie powoduje pętli przy wewnętrznym mapowaniu.
# ---------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [L,R=301]

# ---------------------------------------------------------------------------
# 4) Wewnętrzne mapowanie adresów bez rozszerzenia .html
#    Przykład:
#    /podlogi  ->  /podlogi.html
#
#    Reguła działa tylko wtedy, gdy żądany adres nie jest istniejącym
#    folderem ani istniejącym plikiem, a odpowiadający mu plik .html istnieje.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

# ---------------------------------------------------------------------------
# 5) CACHE — czasy wygasania treści
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — 10 minut
  ExpiresByType text/html "access plus 10 minutes"

  # CSS / JS — 2 dni
  ExpiresByType text/css "access plus 2 days"
  ExpiresByType application/javascript "access plus 2 days"
  ExpiresByType text/javascript "access plus 2 days"

  # Obrazy:
  # JPEG / PNG / GIF / SVG / ICO — 7 dni
  # WEBP — 2 dni
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 2 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"

  # Fonty — 180 dni
  ExpiresByType font/woff2 "access plus 180 days"
  ExpiresByType font/woff "access plus 180 days"
</IfModule>

<IfModule mod_headers.c>
  # HTML — bez agresywnego cache
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CSS / JS — 2 dni (172800 s)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=172800"
  </FilesMatch>

  # Obrazy — 2 dni (172800 s)
  # Uwaga: ten nagłówek obejmuje też pliki JPG/PNG/GIF/SVG/ICO,
  # więc w praktyce może nadpisywać dłuższe wartości z ExpiresByType.
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=172800"
  </FilesMatch>

  # Fonty — 180 dni
  <FilesMatch "\.(woff|woff2)$">
    Header set Cache-Control "public, max-age=15552000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 6) Kompresja GZIP dla tekstowych zasobów i SVG
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 7) Podstawowe nagłówki bezpieczeństwa
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# HSTS — włącz dopiero wtedy, gdy masz pewność,
# że cała strona i wszystkie zasoby zawsze działają po HTTPS
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
# </IfModule>

###############################################################################
# KONIEC
